      "options": {},
      "inspect": "strippable",
      "disarm": "defused",
      "findings": [
        "info EMBEDDED_FILE/PLUGIN_SCRUBBED",
        "info EMBEDDED_FILE/PLUGIN_SCRUBBED in level1.pdf",
        "info EMBEDDED_FILE/PLUGIN_SCRUBBED in level1.pdf > level2.pdf",
        "info EMBEDDED_FILE/PLUGIN_SCRUBBED in level1.pdf > level2.pdf > level3.pdf",
